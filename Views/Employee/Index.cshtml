@model List<EmployeeMVC.Models.Employee>

<h2>Employee List</h2>

<a href="/Employee/Create">+ Add Employee</a>

<table border="1" cellpadding="10">
    <tr>
        <th>Name</th>
        <th>Department</th>
        <th>Designation</th>
        <th>Image</th>
        <th>Action</th>
    </tr>

    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Name</td>
            <td>@e.Department.Name</td>   <!-- FIX -->
            <td>@e.Designation</td>

            <td>
                @if (!string.IsNullOrEmpty(e.ImageUrl))
                {
                    <img src="@e.ImageUrl" width="80" />
                }
            </td>

            <td>
                <a href="/Employee/Edit/@e.Id">Edit</a> |
                <a href="/Employee/Delete/@e.Id">Delete</a>
            </td>
        </tr>
    }
</table>